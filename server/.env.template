# ======================================================
#  .env.template → 복사해서 .env 로 저장 후 값 입력
#  .env 는 절대 git commit 하지 마세요!
# ======================================================

# 한국투자증권 Open API (실전투자)
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=여기에_앱키_입력
KIS_APP_SECRET=여기에_앱시크릿_입력

# 계좌번호 (예: 50012345-01)
KIS_ACCOUNT_NO=00000000-01

# 폰에서 서버 접속 시 사용할 비밀번호 (영문+숫자 20자 이상 권장)
CONTROL_SECRET=여기에_강한_비밀번호_입력

# 서버 포트 (기본 8000)
PORT=8000
